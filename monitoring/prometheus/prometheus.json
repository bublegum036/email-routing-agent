{
  "global": {
    "scrape_interval": "15s",
    "evaluation_interval": "15s"
  },
  "rule_files": [
    "/etc/prometheus/alerts.json"
  ],
  "scrape_configs": [
    {
      "job_name": "email-router-exporter",
      "static_configs": [
        {
          "targets": [
            "exporter:9108"
          ]
        }
      ]
    },
    {
      "job_name": "prometheus",
      "static_configs": [
        {
          "targets": [
            "localhost:9090"
          ]
        }
      ]
    }
  ]
}
