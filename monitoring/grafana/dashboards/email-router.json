{
  "uid": "email-router-local",
  "title": "Email router — локальный стенд",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "source",
        "type": "custom",
        "query": "current,baseline",
        "current": {
          "text": "current",
          "value": "current"
        },
        "options": []
      },
      {
        "name": "mode",
        "type": "custom",
        "query": "workflow,agent",
        "current": {
          "text": "workflow",
          "value": "workflow"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Границы наблюдения",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Снимки регрессионного стенда, не производственная почта. **current** — последний live-regression; **baseline** — старая версия. Пустой agent означает отсутствие такого прогона. Успех и forbidden — результаты программного проверяющего кода. Токены показаны как известная сумма; неизвестный расход вынесен отдельно. [Правила тревог](http://localhost:19090/alerts). Внешние уведомления не подключены."
      }
    },
    {
      "id": 2,
      "title": "Источник загружен (1 = да)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "email-router-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "email_router_source_loaded{source=\"$source\"}",
          "instant": true,
          "legendFormat": "{{source}} / {{mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
