            "content": "{\"history\": {\"candidates\": [], \"data\": {\"complete\": true, \"customer_id\": \"C-11\", \"data_classification\": \"synthetic\", \"id\": \"thread-05\", \"messages\": [{\"message_id\": \"prev-05\", \"sender\": \"sales-north@internal.example.test\", \"sent_at\": \"2026-10-14\", \"text\": \"Для Вектор Север (C-11) предлагаем вариант 1: три новых комплекта; вариант 2: пять новых комплектов. Списание денег не согласовано.\"}]}, \"error\": null, \"evidence_id\": \"obs-abea7df5abd74ecb\", \"status\": \"found\"}, \"message\": {\"data_classification\": \"synthetic\", \"id\": \"mail-05\", \"sender\": \"anna@customer.example.test\", \"text\": \"Согласны на второй вариант. Запускайте\", \"thread_id\": \"thread-05\"}}",
